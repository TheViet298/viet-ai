{
  "description": "Log Codex prompts locally in .ai-log/session.jsonl",
  "hooks": {
    "SubmitUserPrompt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "repo_root=$(git rev-parse --show-toplevel) && AI_LOG_DIR=\"$repo_root/.ai-log\" bash \"$repo_root/scripts/_pyrun.sh\" \"$repo_root/scripts/log_hook.py\" --tool=codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
