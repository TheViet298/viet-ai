# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=your-openai-base-url
# Or use other providers:
# ANTHROPIC_API_KEY=
GOOGLE_API_KEY=your-google-ai-key
MODEL_NAME=gemini-3.8-flash

# ---- Database ----
DATABASE_URL=sqlite:///./data/app.db
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
AGENT_LLM_ENABLED=true
RAG_MAX_DISTANCE=0.70
# Set distinct long random tokens to enable the demo authenticated APIs.
CUSTOMER_DEMO_TOKEN=
STAFF_DEMO_TOKEN=
SERVICE_POINTS_FILE=./fixtures/service_points.demo.json
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
