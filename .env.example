# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=your-openai-base-url
# Or use other providers:
# ANTHROPIC_API_KEY=
GOOGLE_API_KEY=your-google-ai-key
MODEL_NAME=gemini-2.5-flash
DASHBOARD_VISION_ENABLED=true
DASHBOARD_VISION_MODEL=gemini-3.5-flash
DASHBOARD_VISION_TIMEOUT_S=25

# ---- Database ----
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# For SQLite (development):
DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Required in production; use a random secret with at least 32 characters.
# Development has a local-only fallback when this is blank.
AUTH_SECRET_KEY=

# Staff and Demo Credentials (DO NOT commit real values; generate via: openssl rand -base64 24)
STAFF_SEED_USERNAME=staff@vinfast.vn
STAFF_SEED_PASSWORD=
DEMO_SEED_PASSWORD=

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Exterior image / CarDD CPU runtime ----
# CARDD_PYTHON_EXECUTABLE=D:/142.AI20K/P-142/data/vision/runtime-env/Scripts/python.exe
CARDD_INFERENCE_TIMEOUT_S=45
AGENT_TURN_TIMEOUT_S=20
AGENT_LLM_TIMEOUT_S=12
RAG_RETRIEVAL_TIMEOUT_S=5
IMAGE_ROUTING_TIMEOUT_S=12
IMAGE_ROUTING_MIN_CONFIDENCE=0.8
